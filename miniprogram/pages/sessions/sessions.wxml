<!-- 根容器带 themeClass（深色时是 theme-dark）：深色变量挂在这个 class 上，
     靠继承铺满整页。挂在**根 view** 上而不是 page —— 变量表的选择器是 .theme-dark，
     挂在子树深处只能染到那一小片。 -->
<view class="page-pad {{themeClass}}">

  <!-- 容器没有 WebSocket 能力时，唯一要说的就是这一句 -->
  <view wx:if="{{!socketReady}}" class="warn card">
    <view class="warn-title">当前环境无法连接</view>
    <view class="warn-text">
      这个运行环境没有 WebSocket（{{diagGlobal}}.connectSocket 不存在）。
      请用微信开发者工具或真机调试运行。
    </view>
    <view class="footer-link" hover-class="pressed" bindtap="onCopyDiag">复制诊断信息</view>
  </view>

  <!-- 未配对：首页就是一个扫码入口。
       原来这里放了三步说明卡 + 一个「扫码配对主机」按钮，按钮还要再跳一页 ——
       三步说明是 pair 页那套表单的说明书，表单已经没有了，说明也就没人读了。 -->
  <block wx:if="{{!paired}}">
    <view class="hero">
      <view class="hero-mark">DSH</view>
      <view class="hero-title">远程控制</view>
      <view class="hero-desc">在手机上驱动主机上的 DeepSeek Harness。</view>

      <!-- 主路径只有一条，且就地完成：扫完即连，不跳页 -->
      <view class="btn-gap">
        <t-button
          theme="primary"
        size="large"
        block
        loading="{{busy}}"
        disabled="{{busy || !scanReady}}"
        bindtap="onScan">{{busy ? '正在连接…' : '扫描主机二维码'}}</t-button>
      </view>
      <view wx:if="{{!scanReady}}" class="hero-note muted">当前环境没有扫码能力，请用下面的手动输入。</view>

      <!-- 手动输入：默认收起。没摄像头（模拟器）或二维码扫不出来时才需要它，
           平时占版面却没人用 —— 折叠起来，但**入口必须一直在**，
           「藏起来」和「折叠起来」的区别是后者一眼看得见。 -->
      <view class="manual-toggle" hover-class="pressed" bindtap="onToggleManual">
        <view class="caret {{manualOpen ? 'up' : ''}}"></view>
        <text>{{manualOpen ? '收起手动输入' : '手动输入'}}</text>
      </view>

      <view class="card manual" wx:if="{{manualOpen}}">
        <view class="manual-label">粘贴二维码内容</view>
        <view class="field-box">
          <input
            class="field-input"
            placeholder="dshr:/p?…"
            placeholder-class="field-ph"
            confirm-type="done"
            value="{{pasteText}}"
            bindinput="onPasteInput"
            bindblur="onPasteCommit"
            bindconfirm="onPasteCommit" />
          <view
            wx:if="{{pasteText}}"
            class="field-clear"
            hover-class="pressed"
            hover-stay-time="80"
            bindtap="onPasteClear">✕</view>
          <view
            wx:else
            class="field-paste"
            hover-class="pressed"
            hover-stay-time="80"
            bindtap="onPasteClipboard">粘贴</view>
        </view>

        <!-- 6 位配对码：二维码里没带时才要手输。进度点给一个「还差几位」的可见反馈 -->
        <view class="manual-label">主机上的 6 位配对码</view>
        <view class="code-box">
          <input
            class="code-input"
            type="number"
            maxlength="6"
            placeholder="000000"
            placeholder-class="code-ph"
            value="{{token}}"
            bindinput="onTokenInput" />
          <view class="code-scale">
            <view
              wx:for="{{[0, 1, 2, 3, 4, 5]}}"
              wx:key="*this"
              class="code-pip {{token.length > item ? 'on' : ''}}"></view>
          </view>
        </view>

        <view class="btn-gap">
          <t-button theme="primary" variant="light" size="large" block loading="{{busy}}" disabled="{{busy}}" bindtap="onPair">
            {{busy ? '配对中…' : '开始配对'}}
          </t-button>
        </view>

        <view class="foot-note muted">配对密钥只保存在本机，指令在手机上加密后再发出。</view>
      </view>
    </view>
  </block>

  <block wx:if="{{paired}}">
    <!-- 主机卡：只回答"现在到底通不通"。防休眠开关已下线：
         它的可用性完全取决于主机那侧有没有 caffeinate 之类的后端，
         在多数机器上是个永远点不动的开关 —— 不如不给。 -->
    <view class="host card">
      <view class="host-head">
        <view class="dot {{statusTheme}} {{connecting ? 'blink' : ''}}"></view>
        <view class="host-name ellipsis">{{hostLabel || '主机'}}</view>
        <view class="pill {{statusTheme}}">{{statusLabel}}</view>
      </view>
      <view class="host-sub ellipsis">{{statusText || '已就绪'}}{{linkAgeText}}</view>

      <!-- 解除配对：**在这张卡上**（2026-10-04 用户要求从底部挪进来）。
           这张卡写的就是"现在连的是哪台主机、通不通"，"不要这台了"是它的动作，
           沉在页面最底部没人找得到。底部原来挨着的那颗多余入口同时删除：
           先解除、再扫码就是再来一次，多一颗按钮只多一次误触。 -->
      <view class="host-actions">
        <view class="host-danger" hover-class="pressed" hover-stay-time="80" bindtap="onUnpair">解除配对</view>
      </view>
    </view>

    <!-- 分区标题右侧放「新建会话」：它是这一页的主动作，跟着列表走。
         不隐藏而是在离线时置灰 —— 一个会突然消失的入口比一个说明白的禁用好懂得多。 -->
    <!-- G1 待办优先：挂起的审批/提问抢首屏。每件一行并带是哪条会话，
         点开即进那条会话的上下文（onOpen 同一套）。没有时整区不占地方。 -->
    <block wx:if="{{pendingCount}}">
      <view class="section-title">
        <text>等你处理</text>
        <text class="section-count">{{pendingCount}}</text>
      </view>
      <view class="card">
        <block wx:for="{{pending}}" wx:key="id">
          <view wx:if="{{index > 0}}" class="sess-line"></view>
          <view
            class="sess"
            hover-class="pressed"
            hover-stay-time="80"
            data-id="{{item.id}}"
            data-title="{{item.title}}"
            data-workspace="{{item.workspace}}"
            bindtap="onOpen">
            <view class="sess-bar primary"></view>
            <view class="sess-main">
              <view class="sess-head">
                <view class="sess-title ellipsis">{{item.title}}</view>
                <view class="sess-badge primary">
                  <text>{{item.badgeText}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </block>
    <view class="section-title">
      <text>会话</text>
      <text class="section-count">{{sessions.length}}</text>
      <view
        class="section-action {{status === 'online' ? '' : 'off'}} {{creating ? 'busy' : ''}}"
        hover-class="{{status === 'online' && !creating ? 'pressed' : ''}}"
        hover-stay-time="80"
        bindtap="onNewSession"
        bindlongpress="onNewSessionLongPress">
        <view wx:if="{{creating}}" class="new-spin"></view>
        <text>{{creating ? '正在新建…' : '＋ 新建会话'}}</text>
      </view>
    </view>

    <view wx:if="{{sessions.length === 0}}" class="card empty-card">
      <t-empty
        icon="chat"
        description="{{archivedCount ? '这里没有进行中的会话（' + archivedCount + ' 条已归档，在下面）' : (status === 'online' ? '主机上还没有会话。点上面的「＋ 新建会话」开一条' : '连上主机后，这里会列出它的会话')}}" />
    </view>

    <!-- 一条会话一行，整张列表一张卡（2026-10-05 用户：还是原来的样式，不要卡片）。
         2026-10-05 白天那一版"一会话一卡"（1.1.16）撤了。
         但排版重排了：原来是**三栏**——左边一列（标题/路径），右边一列
         （项目名/徽标/时间），于是一件事被拆成两列读，右列还摞了三层。
         现在两行，按"读的人先关心什么"排：
             第一行  标题 ............. 状态徽标
             第二行  [项目名] 全路径 ......... 时间
         也就是"是什么"一行，"挂在哪儿、什么时候"一行。 -->
    <view wx:else class="card">
      <block wx:for="{{sessions}}" wx:for-index="idx" wx:key="id">
        <!-- 分隔线用显式元素而不是 :not(:last-child)：wxss 的选择器支持面越窄越好 -->
        <view wx:if="{{idx > 0}}" class="sess-line"></view>
        <view
          class="sess"
          hover-class="pressed"
          hover-stay-time="80"
          data-id="{{item.id}}"
          data-title="{{item.title}}"
          data-workspace="{{item.workspace}}"
          bindtap="onOpen"
          bindlongpress="onSessionLongPress">
          <!-- 左侧色条：运行中/待办扫一眼就能看出来，不用逐行读文字 -->
          <view class="sess-bar {{item.badgeTheme}}"></view>

          <view class="sess-main">
            <!-- 第一行：标题 + 状态。两者都是"这条现在怎么了"，放一行。 -->
            <view class="sess-head">
              <view class="sess-title ellipsis">{{item.title}}</view>
              <!-- 状态徽标：第一行最右。
                   **里面不放脉冲点**（2026-10-05 用户：一行两个点看起来有点怪）。
                   原先这里有一颗 10rpx 闪烁圆点 + 文字，而第二行项目名左侧
                   也有一颗 12rpx 品牌色圆点——两颗点挨着两行，重复又晃眼。
                   徽标本身有填色（primary 蓝 / warning 橙 / 默认灰），
                   颜色已经说清状态，不必再靠一颗点强调。
                   会话列表里的 .pulse 规则随之删掉（没有 wxml 再引用它）。
                   @keyframes dot-blink 仍留在 app.wxss——聊天页的在跑圆点
                   和顶栏的连接点都在用它，是共享的。 -->
              <view class="sess-badge {{item.badgeTheme}}">
                <text>{{item.badgeText}}</text>
              </view>
            </view>
            <!-- 第二行：项目名 + 时间。
                 2026-10-05 用户：去掉路径只保留项目标签，强化项目样式，
                 "不一定要用标签形式"，重新设计。
                 原来这里是 [描边胶囊] + 全路径 + 时间三样并排。
                 改成**品牌色圆点 + 24rpx 深灰文字**，不用胶囊：
                 胶囊是"分类角标"的常规形式，但它把项目名关在小方块里，
                 字号最大也只到 20rpx。路径去掉之后这一行只剩它和时间，
                 横向空间够了，所以项目名值得占到 24rpx（跟时间 20rpx
                 拉开一档，又仍然小于标题 30rpx）。
                 圆点用 CSS 画，不用图标字体——真机缺字形。 -->
            <view class="sess-meta">
              <view wx:if="{{item.workspaceTag}}" class="sess-project">
                <view class="sess-project-dot"></view>
                <text class="sess-project-name ellipsis">{{item.workspaceTag}}</text>
              </view>
              <view class="sess-time">{{item.updatedAt}}</view>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 归档会话（2026-10-07）：原来被**直接丢掉**，只在底部留一句
         「已隐藏 N 个归档会话」——于是归档在小程序上不可逆：主机那边有
         cmd.archive_session，列表也真的收到了那些行，用户却再也找不回来。
         现在单独成一组、默认折叠（大多数归档是"做完了先收起来"），
         展开后每行长按可取消归档。
         ⚠️ 空列表时整区不占地方：那句话说给"有过归档"的人听。 -->
    <view wx:if="{{archivedCount}}" class="section-title">
      <text>归档</text>
      <view
        class="section-action"
        hover-class="pressed"
        hover-stay-time="80"
        bindtap="onToggleArchived">
        <view class="caret {{archivedOpen ? 'up' : ''}}"></view>
        <text>{{archivedOpen ? '收起' : '展开'}}</text>
      </view>
    </view>

    <view wx:if="{{archivedOpen && archivedCount}}" class="card">
      <block wx:for="{{archivedSessions}}" wx:for-index="idx" wx:key="id">
        <view wx:if="{{idx > 0}}" class="sess-line"></view>
        <view
          class="sess"
          hover-class="pressed"
          hover-stay-time="80"
          data-id="{{item.id}}"
          data-title="{{item.title}}"
          bindtap="onArchivedTap"
          bindlongpress="onArchivedLongPress">
          <view class="sess-bar"></view>
          <view class="sess-main">
            <view class="sess-head">
              <view class="sess-title ellipsis">{{item.title}}</view>
              <!-- 进度**就地**显示在徽标位上：不在行里加第二个指示器，
                   那一行已经有色条/标题/徽标/项目名/时间五样了。 -->
              <view class="sess-badge {{archivingId === item.id ? 'primary' : 'default'}}">
                <text>{{archivingId === item.id ? '处理中' : '已归档'}}</text>
              </view>
            </view>
            <view class="sess-meta">
              <view wx:if="{{item.workspaceTag}}" class="sess-project">
                <view class="sess-project-dot"></view>
                <text class="sess-project-name ellipsis">{{item.workspaceTag}}</text>
              </view>
              <view class="sess-time">{{item.updatedAt}}</view>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 底部只剩主题切换：配对相关的动作都收到主机卡上去了
         （解除配对在卡里，旁边那颗多余入口 2026-10-04 删除——先解除再扫码即可）。 -->
    <view class="footer-row">
      <view class="theme-toggle" hover-class="pressed" hover-stay-time="80" bindtap="onToggleTheme">
        <view class="theme-glyph {{themeName}}"></view>
        <text>{{themeName === 'dark' ? '浅色' : '深色'}}</text>
      </view>
    </view>
  </block>
</view>
